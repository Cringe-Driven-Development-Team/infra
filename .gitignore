# Pulumi
node_modules/
pulumi/sdks/
pulumi/package-lock.json
pulumi/Pulumi.*.yaml
!pulumi/Pulumi.*.yaml.example
# Конфиг прода коммитится, как Pulumi.main.yaml у bootstrap: учётные данные — из selectel.env,
# секретов в нём нет (encryptionsalt — не секрет). Без него у коллег не работает preview.
!pulumi/Pulumi.prod.yaml
# Экспорт стейта при переезде (stack export --show-secrets) — секреты в открытом виде
*state-export*.json
# Любой экспорт стека (prod-export.json и т.п.) — секреты в открытом виде
*-export.json
cellestial-*.json

# Ansible
ansible/clouds.yaml
**/vault.yml
*.retry

# Misc
secrets.txt
.DS_Store
__pycache__/

# Бэкапы конфигов (могут содержать зашифрованные секреты)
*.bak


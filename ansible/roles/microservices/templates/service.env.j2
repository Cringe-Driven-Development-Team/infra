DATABASE_URL=postgres://{{ service }}_app:{{ vault_microservices_postgres[service].app | urlencode | replace('/', '%2F') }}@postgres:5432/{{ app_postgres_database }}?sslmode=disable&pool_max_conns=8
TLS_CA_FILE=/run/secrets/service/ca.crt
TLS_CERT_FILE=/run/secrets/service/{{ service }}.crt
TLS_KEY_FILE=/run/secrets/service/{{ service }}.key
VERSION={{ microservices_desired[service].source_sha }}
WORKERS_PAUSED={{ microservices_workers_paused | default(microservices_first_cutover | default(false)) | bool | lower }}
{% if service == 'identity' %}
BFF_API_KEY={{ bff_api_key }}
JWT_SECRET={{ jwt_secret }}
TOTP_ENCRYPTION_KEY={{ totp_encryption_key }}
ACCESS_TOKEN_TTL={{ app_access_token_ttl }}
REFRESH_TOKEN_TTL={{ app_refresh_token_ttl }}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}
REDIS_DB=0
WORKSPACE_GRPC_ADDR=workspace.internal.cellestial.ru:9090
{% for key, value in microservices_aws.items() %}
{{ key }}={{ value }}
{% endfor %}
{% elif service == 'workspace' %}
BFF_API_KEY={{ bff_api_key }}
WORKSPACE_CURSOR_KEY={{ vault_workspace_cursor_key }}
IDENTITY_GRPC_ADDR=identity.internal.cellestial.ru:9090
ENVIRONMENTS_GRPC_ADDR=environments.internal.cellestial.ru:9090
{% else %}
{% for key, value in (microservices_runtime_env | combine(runtime_extra_env | default({}))).items() if key not in ['RUNTIME_PYTHON_IMAGE', 'RUNTIME_AGENT_VERSION', 'AGENT_GRPC_PORT'] %}
{{ key }}={{ value }}
{% endfor %}
AGENT_GRPC_PORT=9090
RUNTIME_PYTHON_IMAGE={{ microservices_desired.environments.kernel_ref }}
RUNTIME_AGENT_VERSION={{ microservices_desired.environments.agent_version }}
{% endif %}

# Managed by Ansible. Caddy сам получает и продлевает сертификат Let's Encrypt
# для домена из первой строки (A-запись должна указывать на этот сервер).
{# Политика под то, что грузит клиент: чанки JS и CSS — с CDN бакета релизов, картинки и шрифты —
    со статики, аватарки — со своего бакета, API — свой домен. data: в img-src — иконки: они заданы
    в CSS как mask-image с SVG в data:. Инлайновых скриптов и style-атрибутов в разметке нет. -#}
{% set caddy_csp = [
    "default-src 'none'",
    "script-src https://" ~ frontend_cdn_domain,
    "style-src https://" ~ frontend_cdn_domain,
    "img-src https://" ~ frontend_cdn_domain ~ " https://" ~ frontend_static_domain
        ~ " https://" ~ avatars_public_domain ~ " data:",
    "font-src https://" ~ frontend_static_domain,
    "connect-src 'self'",
    "base-uri 'none'",
    "form-action 'self'",
    "frame-ancestors 'none'",
] | join('; ') %}
{{ app_domain }} {
	# Браузер не угадывает тип ответа по содержимому. defer — заголовок ставится при отправке ответа
	# и заменяет пришедший от API или хранилища, а не дублирует его.
	header {
		X-Content-Type-Options nosniff
		defer
	}

	# Внутренний /health BFF снаружи не виден. Go (/api/v1) наружу не смотрит: BFF на
	# неизвестные /api/* отвечает 404 без HTML и в Go их не проксирует.
	handle /health {
		respond 404
	}

	# Всё остальное — BFF: HTML с пользователем, /api/trpc, публичные файлы сборки. Чанки JS и CSS
	# браузер берёт с CDN каталога своего релиза напрямую. До первой выкатки BFF — заглушка.
	handle {
{% if caddy_bff_enabled | default(caddy_bff_deployed) | bool %}
		reverse_proxy bff:3000 {
			# ограничивает последствия XSS: страница грузит скрипты, стили, картинки и шрифты только
			# со своих доменов; у Report-Only нарушения только пишутся в консоль браузера
			header_down {{ 'Content-Security-Policy-Report-Only' if caddy_csp_report_only | default(true) | bool else 'Content-Security-Policy' }} "{{ caddy_csp }}"
		}
{% else %}
		respond "BFF is not deployed" 503
{% endif %}
	}
}

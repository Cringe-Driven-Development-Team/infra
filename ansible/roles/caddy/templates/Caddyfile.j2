# Managed by Ansible. Caddy сам получает и продлевает сертификат Let's Encrypt
# для домена из первой строки (A-запись должна указывать на этот сервер).
{# Политика под то, что грузит клиент: чанки JS и CSS — с CDN бакета релизов, картинки и шрифты —
    со статики, аватарки — со своего бакета, API — свой домен. data: в img-src — иконки: они заданы
    в CSS как mask-image с SVG в data:. 'self' — файлы PWA, которые отдаёт BFF: service worker, манифест,
    его иконки, стили и шрифт офлайн-страницы. CSS не ограничен (infra#153): HTML-вывод ячеек (Polars и др.)
    в iframe srcdoc наследует эту политику и несёт встроенные <style>, style-атрибуты и внешние стили.
    Инлайновых скриптов в разметке нет. -#}
{% set caddy_csp = [
    "default-src 'none'",
    "script-src https://" ~ frontend_cdn_domain,
    "style-src * data: blob: 'unsafe-inline'",
    "img-src 'self' https://" ~ frontend_cdn_domain ~ " https://" ~ frontend_static_domain
        ~ " https://" ~ avatars_public_domain ~ " data:",
    "font-src 'self' https://" ~ frontend_static_domain,
    "connect-src 'self' " ~ private_files_upload_origin,
    "manifest-src 'self'",
    "worker-src 'self'",
    "base-uri 'none'",
    "form-action 'self'",
    "frame-src 'self'",
] | join('; ') %}
{% set report_only = caddy_csp_report_only | default(true) | bool %}
{% set csp_header = 'Content-Security-Policy-Report-Only' if report_only else 'Content-Security-Policy' %}
{% set other_csp_header = 'Content-Security-Policy' if report_only else 'Content-Security-Policy-Report-Only' %}
{% if monitoring_private_ip | default('') %}
{
	metrics
}

http://:9180 {
	@scrape {
		remote_ip {{ monitoring_private_ip }}/32
		method GET
		path /metrics
	}
	handle @scrape {
		metrics /metrics
	}
	handle {
		respond 403
	}
}
{% endif %}
{{ app_domain }} {
	# Браузер не угадывает тип ответа по содержимому и после первого ответа по HTTPS ходит на этот домен
	# только по HTTPS (HSTS, без поддоменов и preload). defer — заголовок ставится при отправке ответа
	# и заменяет пришедший от API или хранилища, а не дублирует его.
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		defer
	}

	# Внутренний /health BFF снаружи не виден. Go (/api/v1) наружу не смотрит: BFF на
	# неизвестные /api/* отвечает 404 без HTML и в Go их не проксирует.
	handle /health {
		respond 404
	}

	# Всё остальное — BFF: HTML с пользователем, HTTP API /api/*, публичные файлы сборки. Чанки JS и CSS
	# браузер берёт с CDN каталога своего релиза напрямую. До первой выкатки BFF — заглушка.
{% if caddy_bff_enabled | default(caddy_bff_deployed) | bool %}
	@embed {
		path /embed/*
		path_regexp ^/embed/
	}
	# Встраивать можно только документы из пространства /embed/.
{% for matcher, ancestors in [('@embed', "'self'"), ('', "'none'")] %}
	handle{{ ' ' ~ matcher if matcher else '' }} {
		reverse_proxy bff:3000 {
			header_down -{{ other_csp_header }}
			header_down {{ csp_header }} "{{ caddy_csp }}; frame-ancestors {{ ancestors }}"
		}
	}
{% endfor %}
{% else %}
	handle {
		respond "BFF is not deployed" 503
	}
{% endif %}
}

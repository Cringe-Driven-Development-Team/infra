# Managed by Ansible. Ручной запуск: systemctl start restic-backup; журнал: journalctl -u restic-backup
[Unit]
Description=restic backup of auxiliary VPS data to S3
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/env
# Кэш restic: без него (у юнита нет $HOME) каждый запуск заново читает индекс репозитория из S3
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/usr/bin/restic backup --host {{ restic_backup_host }} {{ restic_backup_paths | join(' ') }}
ExecStartPost=/usr/bin/restic forget --host {{ restic_backup_host }} --keep-daily {{ restic_backup_keep_daily }} --keep-weekly {{ restic_backup_keep_weekly }} --prune

# Managed by Ansible. Secrets stay on the VPS; Compose reads this file. Only the services of this host
# (app_services, infra#59) get their settings and secrets.
{% if 'api' in app_services %}
BACKEND_IMAGE_TAG={{ app_backend_tag }}
{% endif %}
{% if 'bff' in app_services %}
BFF_IMAGE_REF={{ app_bff_ref }}
BFF_RELEASE_SHA={{ app_bff_release }}
{% endif %}
{% if 'api' in app_services %}
HOST=0.0.0.0
PORT=8080
POSTGRES_HOST=postgres
POSTGRES_USER={{ app_postgres_user }}
POSTGRES_DB={{ app_postgres_database }}
POSTGRES_PASSWORD={{ postgres_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
JWT_SECRET={{ jwt_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}
CSRF_SECRET={{ csrf_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}
ACCESS_TOKEN_TTL={{ app_access_token_ttl }}
REFRESH_TOKEN_TTL={{ app_refresh_token_ttl }}
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS={{ app_cors_allowed_origins }}

# S3 configuration for the API (credentials from Vault).
AWS_REGION={{ (s3_region) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_ACCESS_KEY_ID={{ (notebooks_s3_access_key) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_SECRET_ACCESS_KEY={{ (notebooks_s3_secret_key) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_ENDPOINT_URL_S3={{ (s3_endpoint) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_NOTEBOOKS_BUCKET={{ (notebooks_bucket) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_AVATARS_BUCKET={{ (avatars_bucket) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_AVATARS_PUBLIC_URL={{ ('https://' ~ avatars_public_domain) | replace('$', '$$') | to_json(ensure_ascii=False) }}

# Redis: refresh-сессии бэка (пароль из Vault)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
REDIS_DB=0

# Runtime-VPS сессий (infra#89): Go API создаёт VPS от пользователя runtime-provisioner
RUNTIME_ENABLED={{ runtime_enabled | bool | lower }}
{% if runtime_enabled | bool %}
RUNTIME_PROVIDER={{ runtime_provider }}
RUNTIME_OS_AUTH_URL={{ runtime_os_auth_url }}
RUNTIME_OS_USERNAME={{ runtime_os_username | replace('$', '$$') | to_json(ensure_ascii=False) }}
RUNTIME_OS_PASSWORD={{ runtime_os_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
RUNTIME_OS_USER_DOMAIN_NAME={{ runtime_os_user_domain_name }}
RUNTIME_OS_PROJECT_ID={{ runtime_os_project_id }}
RUNTIME_OS_REGION={{ runtime_os_region }}
RUNTIME_AVAILABILITY_ZONE={{ runtime_availability_zone }}
RUNTIME_NETWORK_ID={{ runtime_network_id }}
RUNTIME_SUBNET_ID={{ runtime_subnet_id }}
RUNTIME_SECURITY_GROUP_ID={{ runtime_security_group_id }}
RUNTIME_IMAGE_ID={{ runtime_image_id }}
RUNTIME_FLAVOR_ID={{ runtime_flavor_id }}
RUNTIME_VOLUME_TYPE={{ runtime_volume_type }}
RUNTIME_SSH_KEY_NAME={{ runtime_ssh_key_name }}
RUNTIME_SSH_USER={{ runtime_ssh_user }}
RUNTIME_SSH_PRIVATE_KEY_FILE=/run/secrets/runtime/ssh_key
RUNTIME_TLS_CA_CERT_FILE=/run/secrets/runtime/ca.crt
RUNTIME_TLS_CA_KEY_FILE=/run/secrets/runtime/ca.key
RUNTIME_TLS_CLIENT_CERT_FILE=/run/secrets/runtime/client.crt
RUNTIME_TLS_CLIENT_KEY_FILE=/run/secrets/runtime/client.key
RUNTIME_WORK_DIR={{ app_runtime_work_dir }}
RUNTIME_BLOCKED_PUBLIC_IPS={{ runtime_blocked_public_ips }}
RUNTIME_SECRETS_KEY={{ runtime_secrets_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
{% for name, value in runtime_extra_env | dictsort %}
{{ name }}={{ value | string | replace('$', '$$') | to_json(ensure_ascii=False) }}
{% endfor %}
{% endif %}
{% endif %}
{% if 'bff' in app_services %}

# BFF (infra#58): ключ сессии из Vault; origin приложения — для CSRF
SESSION_KEY={{ session_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
APP_ORIGIN=https://{{ app_domain }}
{% endif %}
{% if 'api' in app_services or 'bff' in app_services %}
# S2S-ключ BFF и Go (X-BFF-Key): один на обеих машинах
BFF_API_KEY={{ bff_api_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
{% endif %}

# Managed by Ansible. Secrets stay on the VPS; Compose reads this file.
BACKEND_IMAGE_TAG={{ backend_image_tag }}
HOST=0.0.0.0
PORT=8080
POSTGRES_HOST=postgres
POSTGRES_USER={{ app_postgres_user }}
POSTGRES_DB={{ app_postgres_database }}
POSTGRES_PASSWORD={{ postgres_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
JWT_SECRET={{ jwt_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}
CSRF_SECRET={{ csrf_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}
ACCESS_TOKEN_TTL={{ app_access_token_ttl }}
REFRESH_TOKEN_TTL={{ app_refresh_token_ttl }}
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS={{ app_cors_allowed_origins }}

# S3 configuration for the API (credentials from Vault).
AWS_REGION={{ (s3_region) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_ACCESS_KEY_ID={{ (notebooks_s3_access_key) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_SECRET_ACCESS_KEY={{ (notebooks_s3_secret_key) | replace('$', '$$') | to_json(ensure_ascii=False) }}
AWS_ENDPOINT_URL_S3={{ (s3_endpoint) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_NOTEBOOKS_BUCKET={{ (notebooks_bucket) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_AVATARS_BUCKET={{ (avatars_bucket) | replace('$', '$$') | to_json(ensure_ascii=False) }}
S3_AVATARS_PUBLIC_URL={{ ('https://' ~ avatars_public_domain) | replace('$', '$$') | to_json(ensure_ascii=False) }}

# Managed by Ansible (role app). Preserve the existing cellestial Caddy volumes.
name: cellestial

services:
  caddy:
    image: {{ caddy_image }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy:/etc/caddy:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - app

  api:
    image: {{ app_backend_image }}:${BACKEND_IMAGE_TAG:?backend tag is required}
    restart: unless-stopped
    environment:
      HOST: ${HOST:-0.0.0.0}
      PORT: ${PORT:-8080}
      POSTGRES_HOST: ${POSTGRES_HOST:-postgres}
      POSTGRES_USER: ${POSTGRES_USER:?postgres user is required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?postgres password is required}
      POSTGRES_DB: ${POSTGRES_DB:?postgres database is required}
      JWT_SECRET: ${JWT_SECRET:?jwt secret is required}
      CSRF_SECRET: ${CSRF_SECRET:?csrf secret is required}
      ACCESS_TOKEN_TTL: ${ACCESS_TOKEN_TTL:-15m}
      REFRESH_TOKEN_TTL: ${REFRESH_TOKEN_TTL:-720h}
      COOKIE_SECURE: "true"
      CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS:?CORS origins are required}
      AWS_REGION: ${AWS_REGION:?S3 configuration is required}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:?S3 configuration is required}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY:?S3 configuration is required}
      AWS_ENDPOINT_URL_S3: ${AWS_ENDPOINT_URL_S3:?S3 configuration is required}
      S3_NOTEBOOKS_BUCKET: ${S3_NOTEBOOKS_BUCKET:?S3 configuration is required}
      S3_AVATARS_BUCKET: ${S3_AVATARS_BUCKET:?S3 configuration is required}
      S3_AVATARS_PUBLIC_URL: ${S3_AVATARS_PUBLIC_URL:?S3 configuration is required}
      REDIS_HOST: ${REDIS_HOST:-redis}
      REDIS_PORT: ${REDIS_PORT:-6379}
      REDIS_PASSWORD: ${REDIS_PASSWORD:?redis password is required}
      REDIS_DB: ${REDIS_DB:-0}
      # S2S-ключ запросов BFF (X-BFF-Key, backend#41)
      BFF_API_KEY: ${BFF_API_KEY:?bff api key is required}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"]
      interval: 5s
      timeout: 3s
      start_period: 30s
      retries: 20
    networks:
      - app

{% if app_bff_ref %}
  # BFF (infra#58): HTML и /api/trpc снаружи — через Caddy. PORT не задаётся: в .env он для api (8080),
  # а BFF слушает 3000 по умолчанию.
  bff:
    # образ по digest (infra#74): скачан и сверен deploy-bff.yml до записи в .env
    image: ${BFF_IMAGE_REF:?bff image ref is required}
    pull_policy: never
    restart: unless-stopped
    environment:
      SESSION_KEY: ${SESSION_KEY:?session key is required}
      APP_ORIGIN: ${APP_ORIGIN:?app origin is required}
      GO_API_URL: {{ app_bff_go_api_url }}
      BFF_KEY: ${BFF_API_KEY:?bff api key is required}
    # BFF дожидается текущих запросов до 10 с (frontend#2)
    stop_grace_period: 15s
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:3000/health"]
      interval: 5s
      timeout: 3s
      start_period: 10s
      retries: 12
    networks:
      - app

{% endif %}
  postgres:
    image: {{ app_postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?postgres user is required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?postgres password is required}
      POSTGRES_DB: ${POSTGRES_DB:?postgres database is required}
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 3s
      start_period: 10s
      retries: 12
    networks:
      - app

  # Пароль — в redis.conf (0600, читает только redis), а не в --requirepass: аргументы видны в ps
  redis:
    image: {{ app_redis_image }}
    restart: unless-stopped
    command: ["redis-server", "/usr/local/etc/redis/redis.conf"]
    environment:
      REDISCLI_AUTH: ${REDIS_PASSWORD:?redis password is required}
    volumes:
      # Каталог, а не файл: template заменяет redis.conf новым inode, файловый bind mount видел бы старый
      - ./redis:/usr/local/etc/redis:ro
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 5s
      timeout: 3s
      start_period: 5s
      retries: 12
    networks:
      - app

networks:
  app: {}

volumes:
  caddy_data: {}
  caddy_config: {}
  postgres_data: {}
  redis_data: {}

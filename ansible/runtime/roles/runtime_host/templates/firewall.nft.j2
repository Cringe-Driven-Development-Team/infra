#!/usr/sbin/nft -f
# Managed by Ansible (runtime_host). Сеть kernel по контракту backend docs/runtime-agent-network.md.
# Своя таблица: Docker (iptables-nft) свои таблицы ip filter/nat при рестарте пересобирает, эту — нет.
# Цепочки стоят раньше цепочек Docker (priority filter - 10); drop здесь окончателен, accept лишь
# пропускает пакет дальше — к правилам Docker (NAT наружу делает его MASQUERADE).
# Загрузка атомарна: файл целиком применяется или не применяется вовсе.
table inet cellestial
delete table inet cellestial

table inet cellestial {
	# Закрытые назначения: служебные и внутренние сети, публичные адреса инфраструктуры
	set denied_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = {
			{{ (runtime_host_denied_networks + blocked_public_ips) | join(",\n\t\t\t") }}
		}
	}

	# Контейнер ↔ мир и контейнер ↔ контейнер (br_netfilter: соседи по мосту тоже идут через forward)
	chain forward {
		type filter hook forward priority filter - 10; policy accept;

		# IPv6 в сети kernel нет и не будет
		meta nfproto ipv6 iifname "{{ runtime_host_bridge }}" drop
		meta nfproto ipv6 oifname "{{ runtime_host_bridge }}" drop

		# Ответы на разрешённые запросы
		iifname "{{ runtime_host_bridge }}" ct state established,related accept
		oifname "{{ runtime_host_bridge }}" ct state established,related accept

		# Новые входящие в контейнер из сети (другие VPS, соседи по мосту) — запрет
		oifname "{{ runtime_host_bridge }}" drop

		# DNS — только к KERNEL_DNS, TCP/UDP 53 (исключение действует и для резолвера в служебной сети)
		iifname "{{ runtime_host_bridge }}" ip daddr {{ kernel_dns }} meta l4proto { tcp, udp } th dport 53 accept
		# Запрет назначений — раньше разрешения 80/443
		iifname "{{ runtime_host_bridge }}" ip daddr @denied_v4 drop
		# Публичный интернет — только HTTP/HTTPS
		iifname "{{ runtime_host_bridge }}" meta l4proto tcp th dport { 80, 443 } accept
		# Остальное из kernel — запрет
		iifname "{{ runtime_host_bridge }}" drop
	}

	# Контейнер → сам хост (агент 127.0.0.1:{{ runtime_host_agent_port }}, адрес моста, sshd, nginx) — запрет новых
	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname "{{ runtime_host_bridge }}" ct state established,related accept
		iifname "{{ runtime_host_bridge }}" drop
	}

	# Хост → контейнер: только Jupyter TCP {{ runtime_host_jupyter_port }} (агент)
	chain output {
		type filter hook output priority filter - 10; policy accept;
		oifname "{{ runtime_host_bridge }}" ct state established,related accept
		oifname "{{ runtime_host_bridge }}" meta nfproto ipv4 tcp dport {{ runtime_host_jupyter_port }} ct state new accept
		oifname "{{ runtime_host_bridge }}" drop
	}
}

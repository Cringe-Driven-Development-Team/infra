# Managed by Ansible (runtime_agent). Без данных сессии: агент ждёт назначения (POST /assign от Go API)
# и хранит его в своём журнале (STATE_DIR).
HOST=127.0.0.1
PORT={{ runtime_agent_port }}
KERNEL_NETWORK={{ runtime_agent_network }}
KERNEL_DNS={{ kernel_dns }}
IDLE_TIMEOUT_SECONDS={{ runtime_agent_idle_timeout_seconds }}
MAX_OUTPUT_BYTES={{ runtime_agent_max_output_bytes }}
PYTHON_IMAGE={{ python_image }}

{
  "enabledPlugins": {
    "pulumi@cdd": true,
    "ansible@cdd": true,
    "selectel-ops@cdd": true,
    "cdd-tasks@cdd": true
  },
  "extraKnownMarketplaces": {
    "cdd": {
      "source": {
        "source": "github",
        "repo": "Cringe-Driven-Development-Team/claude-plugins"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/devops-skills.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

# Состав образа runtime-VPS (infra#134): единственное место версий. Меняется — пересобрать образ
# (scripts/build-runtime-image.sh) и выкатить его id: RUNBOOK, «Образ runtime-VPS».
# Плейбук сессии сверяет IMAGE_VERSION с /etc/cellestial/runtime-image (runtime_host_image_version).
IMAGE_VERSION=2026.11.08-1

# Публичный образ Selectel ru-9 «Ubuntu 26.04 LTS 64-bit»: Python 3.14, агенту нужен >= 3.13
BASE_IMAGE_ID=16536347-8646-4b56-8db4-7ceb56f2850e
# Размер тома сборки, ГиБ: база, Docker и образы kernel; не больше RUNTIME_ROOT_DISK_GIB (20)
BUILD_VOLUME_GIB=10

# Пакеты Ubuntu — из snapshot.ubuntu.com на этот момент: повторная сборка ставит те же версии
UBUNTU_SNAPSHOT=20261108T120000Z
APT_PACKAGES="ca-certificates=20260816ubuntu0.26.04.2 nftables=1.1.6-1 nginx=1.28.3-2ubuntu1.12 python3-venv=3.14.3-0ubuntu2 python3.14-venv=3.14.4-1ubuntu0.2 python3-packaging=26.0-1"

# Репозиторий Docker хранит все версии; ключ сверяется по отпечатку
DOCKER_GPG_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
DOCKER_PACKAGES="docker-ce=5:29.9.3-1~ubuntu.26.04~resolute docker-ce-cli=5:29.9.3-1~ubuntu.26.04~resolute containerd.io=2.4.2-3~ubuntu.26.04~resolute"

# Образы kernel по digest (RUNTIME_PYTHON_IMAGE / RUNTIME_R_IMAGE backend): слои уже в образе,
# сессия докачивает только отличия своего digest
PYTHON_KERNEL_IMAGE=ghcr.io/cringe-driven-development-team/cellestial-kernel-python@sha256:a6471389c7be514374ba6a18ce178364880ddb515c8b70d5d0a3fe272788e9ac
R_KERNEL_IMAGE=ghcr.io/cringe-driven-development-team/cellestial-kernel-r@sha256:e3a89a6f1a29d3a90ddeaf0e26ac01a2eb60c894d88142884ea64ceae6fd8e37

# Зависимости агента — agent-requirements.txt, копия backend runtime-agent/requirements.txt (984b2ff)
